# ===== 복사해서 .env 로 사용 (.env 는 절대 커밋 금지) =====
APP_ENV=local                       # local | staging | production
POSTGRES_USER=dropship
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dropship
# docker-compose 외부에서 실행할 때만 사용
DATABASE_URL=postgresql+psycopg2://dropship:change-me@localhost:5432/dropship
REDIS_URL=redis://localhost:6379/0
DB_AUTO_MIGRATE=true                 # API 기동 시 alembic upgrade head

# ----- 관리자 인증 -----
JWT_SECRET=                          # 32자 이상 랜덤 (openssl rand -hex 32)
JWT_EXPIRE_MINUTES=480
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=            # 최초 기동 시 관리자 계정 생성. 로그인 후 변경 권장
SERVICE_TOKEN=                       # n8n 등 서버 간 호출용 (X-Service-Token)
CORS_ORIGINS=http://localhost:3000

# ----- 개인정보 암호화 (Fernet 키) -----
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=

# ----- 네이버 커머스 API -----
NAVER_MODE=mock                      # mock | live
NAVER_BASE_URL=https://api.commerce.naver.com/external
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=                 # 커머스API센터 애플리케이션 시크릿 ($2a$... 형식)
NAVER_TOKEN_TYPE=SELF                # SELF | SELLER
NAVER_ACCOUNT_ID=                    # SELLER 타입일 때만
NAVER_SIGN_B64=standard              # standard | urlsafe (공식 Python 예제=standard, Java 예제=urlsafe) → 연결 테스트로 확인
NAVER_RPS=2

# ----- 안전 스위치: 검증이 끝나기 전까지 false 유지 -----
ALLOW_PUBLIC_LISTING=false           # 네이버 실제 상품 등록/수정/판매상태 변경
ALLOW_NAVER_ORDER_ACTIONS=false      # 네이버 발주확인/발송처리/클레임 승인
ALLOW_REAL_PURCHASE=false            # 공급사 실제 발주/결제
ALLOW_PII_TRANSFER=false             # 고객 개인정보 공급사 전송 (공급사 계약 pii_transfer_agreed 도 필요)

# ----- Claude API (없으면 규칙 기반 가공) -----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_ENABLED=true

# ----- 모니터링/알림 -----
SENTRY_DSN=
ALERT_WEBHOOK_URL=                   # Slack/Telegram/n8n webhook
LOG_JSON=true
